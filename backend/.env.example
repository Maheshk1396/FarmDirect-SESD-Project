# ==============================================================================
# FarmDirect Environment Configuration Template
# Copy this file to .env and configure with your environment settings
# ==============================================================================

# Server Configuration
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:3000

# Database Configuration (PostgreSQL with Prisma ORM)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/farmdirect?schema=public

# Security & Authentication
JWT_SECRET=farmdirect_jwt_super_secret_development_key_2026_change_in_production
JWT_EXPIRES_IN=7d
COOKIE_SECRET=farmdirect_cookie_secret_key_change_in_production

# Razorpay Payment Gateway (Test Mode Keys)
# Generate from Razorpay Dashboard: Settings -> API Keys
RAZORPAY_KEY_ID=rzp_test_YourTestKeyIdHere
RAZORPAY_KEY_SECRET=YourRazorpaySecretKeyHere
RAZORPAY_WEBHOOK_SECRET=YourRazorpayWebhookSecretHere

# File Uploads
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=5

# Optional: Cloudinary Storage (If configuring external cloud image storage)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Optional: Nodemailer SMTP (Email notifications)
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="FarmDirect Support <no-reply@farmdirect.in>"
